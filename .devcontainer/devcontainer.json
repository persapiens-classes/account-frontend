{
  "name": "Pnpm with Node & Angular & Cypress & Chromium",

  // base image with trixie
  "image": "mcr.microsoft.com/devcontainers/base:2.2.3-trixie",

  // set environment variables for pnpm config and cypress cache directories
  "containerEnv": {
    "PNPM_CONFIG_STORE_DIR": "/pnpm_data/pnpm_store",
    "PNPM_CONFIG_CACHE_DIR": "/pnpm_data/pnpm_cache",
    "PNPM_CONFIG_STATE_DIR": "/pnpm_data/pnpm_state",
    "CYPRESS_CACHE_FOLDER": "/pnpm_data/cypress_cache"
  },

  "mounts": [
    // pnpm store persistence to speed up rebuilds
    "source=pnpm-store,target=/pnpm_data,type=volume"
  ],

  // 4200 for Angular, 5173 for Vite
  "forwardPorts": [4200, 5173],

  // set the default workspace folder
  "workspaceFolder": "/workspaces/account-frontend",

  // recommended for devcontainers
  "init": true,

  // install chromium, pnpm and cypress
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // run args to allow GUI apps to run in the container
  "runArgs": [
    "-e",
    "DISPLAY=${localEnv:DISPLAY:}",
    "-e",
    "XAUTHORITY=${localEnv:XAUTHORITY:-/tmp/.X11-unix}",
    "-v",
    "${localEnv:XAUTHORITY:/dev/null}:${localEnv:XAUTHORITY:/dev/null}",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix",
    "--ipc=host",
    "--shm-size=2g",
    "--security-opt",
    "seccomp=unconfined"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        // extensions for Angular development
        "Angular.ng-template",
        "SonarSource.sonarlint-vscode",
        "bradlc.vscode-tailwindcss",
        "Fallow-rs.fallow-vscode",
        "oxc.oxc-vscode"
      ]
    }
  }
}

{
  "$schema": "./node_modules/fallow/schema.json",
  "ignoreDependencies": [
    "@cypress/schematic",
    "@openng/optimus-ui-tailwindcss",
    "@tailwindcss/postcss",
    "angular-cli-ghpages",
    "baseline-browser-mapping",
    "istanbul-lib-coverage",
  ],
  "duplicates": {
    "minLines": 5,
    "minTokens": 60,
    "ignoreDefaults": false,
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.angular/**",
      "**/coverage/**",
      "**/pnpm-lock.yaml",
      "**/build/**",
    ],
  },
}
